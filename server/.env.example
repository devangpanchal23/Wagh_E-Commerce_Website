# Server Environment Variables
PORT=5050
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wagh-ecommerce?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=30d
CLIENT_URL=https://your-frontend-domain.com
NODE_ENV=production

# Admin Auth Config
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_admin_password
ADMIN_JWT_SECRET=your_dedicated_admin_jwt_secret_min_32_chars

# Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage
TOKEN_ENCRYPTION_KEY=
